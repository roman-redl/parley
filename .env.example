# .env template. The real .env exists only on the VPS and is never committed.
# Values without quotes. Comments only on their own lines.

# ---- Addresses (LibreChat) ----
# Public address of LibreChat, e.g. https://chat.example.org
DOMAIN_CLIENT=
DOMAIN_SERVER=

# ---- LibreChat secrets (generate on the VPS) ----
# openssl rand -hex 32
CREDS_KEY=
# openssl rand -hex 16
CREDS_IV=
# openssl rand -hex 32
JWT_SECRET=
# openssl rand -hex 32
JWT_REFRESH_SECRET=

# ---- Registration ----
# Registration in LibreChat is closed. Open it only while creating your own account,
# through an ssh tunnel (README, "First login"): any registered user gets bots
# with a terminal in the tools container.
ALLOW_REGISTRATION=false

# ---- Sessions ----
# Login lifetime in milliseconds: 90 days (LibreChat default is 7). The session is not
# extended by use, so a new login (with the 2FA code, if enabled) is needed every 90 days on
# each device. Applies to new logins only. To end all sessions at once (lost device):
# docker compose exec -T mongodb mongosh --quiet LibreChat --eval "db.sessions.deleteMany({})"
REFRESH_TOKEN_EXPIRY=7776000000

# ---- LibreChat: features and providers ----
# Search (Meilisearch) is not used.
SEARCH=false
# One LibreChat replica: lets the schedules engine start without Redis.
SCHEDULES_SINGLE_PROCESS=true
# Anthropic, Google, OpenAI and agents (the bots from modelSpecs run on top of agents).
# Speech-to-text uses OpenAI with its own key (OPENAI_STT_API_KEY).
ENDPOINTS=anthropic,google,openAI,agents
# User the librechat, mongodb and playwright containers run as; must own ./data/librechat,
# ./data/mongo and ./data/web (user id on the VPS). Required: compose fails without them.
UID=1000
GID=1000

# ---- Provider keys (on the VPS: ANTHROPIC_API_KEY is copied from the erudit-bot .env, OPENAI_STT_API_KEY is its OPENAI_API_KEY, GOOGLE_KEY from ~/.config/parley/secrets.env) ----
ANTHROPIC_API_KEY=
GOOGLE_KEY=
# OpenAI chat bots: a project with data sharing turned on (free daily tokens).
OPENAI_API_KEY=
# Speech-to-text (gpt-transcribe): a separate project without data sharing.
OPENAI_STT_API_KEY=

# ---- Model lists (LibreChat) ----
ANTHROPIC_MODELS=claude-opus-5-5,claude-fable-5-2,claude-sonnet-5-5,claude-haiku-5-5
GOOGLE_MODELS=gemini-3.8-flash,gemini-4-argon,gemini-4-hydrogen,gemini-4-carbon
OPENAI_MODELS=gpt-6-luna,gpt-5.4,gpt-5.4-mini

# ---- Caddy network ----
# Network of the compose project where Caddy runs (docker network ls on the VPS).
CADDY_NETWORK=selfhost-music_default

# ---- Tools container ----
# Absolute paths on the VPS: clones of the notes and handoff repositories and the ssh key directory.
NOTES_DIR=
HANDOFF_DIR=
TOOLS_SSH_DIR=
# Signature of the commits made by the agents.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME=
GIT_COMMITTER_EMAIL=
