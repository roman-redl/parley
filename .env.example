# .env template. The real .env exists only on the VPS and is never committed.
# Values without quotes. Comments only on their own lines.

# ---- Addresses (LibreChat) ----
# Public address of LibreChat, e.g. https://chat.example.org
DOMAIN_CLIENT=
DOMAIN_SERVER=

# ---- LibreChat secrets (generate on the VPS) ----
# openssl rand -hex 32
CREDS_KEY=
# openssl rand -hex 16
CREDS_IV=
# openssl rand -hex 32
JWT_SECRET=
# openssl rand -hex 32
JWT_REFRESH_SECRET=

# ---- Registration ----
# Registration in LibreChat is closed. Open it only while creating your own account,
# through an ssh tunnel (README, "First login"): any registered user gets bots
# with a terminal in the tools container.
ALLOW_REGISTRATION=false

# ---- LibreChat: features and providers ----
# Search (Meilisearch) is not used.
SEARCH=false
# Anthropic, Google, OpenAI and agents (the bots from modelSpecs run on top of agents).
# The OpenAI key is also used for speech-to-text.
ENDPOINTS=anthropic,google,openAI,agents
# User the librechat and mongodb containers run as;
# must own ./data/librechat and ./data/mongo (user id on the VPS).
UID=1000
GID=1000

# ---- Provider keys (on the VPS: ANTHROPIC_API_KEY and OPENAI_API_KEY are copied from the erudit-bot .env, GOOGLE_KEY from ~/.config/parley/secrets.env) ----
ANTHROPIC_API_KEY=
GOOGLE_KEY=
# Used for OpenAI chat and for speech-to-text (gpt-transcribe).
OPENAI_API_KEY=

# ---- Model lists (LibreChat) ----
ANTHROPIC_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
GOOGLE_MODELS=gemini-3.8-flash,gemini-4-argon,gemini-4-carbon
OPENAI_MODELS=gpt-6-luna

# ---- Open WebUI ----
# Token signing and encryption secret: openssl rand -hex 32
WEBUI_SECRET_KEY=

# ---- Caddy network ----
# Network of the compose project where Caddy runs (docker network ls on the VPS).
CADDY_NETWORK=selfhost-music_default

# ---- Tools container ----
# Absolute paths on the VPS: clones of the notes and handoff repositories and the ssh key directory.
NOTES_DIR=
HANDOFF_DIR=
TOOLS_SSH_DIR=
# Signature of the commits made by the agents.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME=
GIT_COMMITTER_EMAIL=
